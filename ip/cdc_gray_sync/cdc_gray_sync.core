CAPI=2:
name: justint:cdc:gray_sync:1.0.0
description: One bit Synchronizer

filesets:
  generic:
    files: [rtl/cdc_gray_sync_generic.sv]
    file_type: systemVerilogSource
    depend:
      - ">=justint:shared:includes:1.0.0"

  fpga:
    files: [rtl/cdc_gray_sync_fpga.sv]
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - "tool_vivado ? (fpga)"
      - "!tool_vivado ? (generic)"
    toplevel: cdc_gray_sync
