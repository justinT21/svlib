CAPI=2:
name: justint:cdc:bus_handshake:1.0.0
description: Bus Handshake Synchronizer

filesets:
  generic:
    files: [rtl/cdc_bus_handshake_generic.sv]
    file_type: systemVerilogSource
    depend:
      - ">=justint:shared:includes:1.0.0"
      - ">=justint:cdc:bit_sync:1.0.0"

  fpga:
    files: [rtl/cdc_bus_handshake_fpga.sv]
    file_type: systemVerilogSource

targets:
  default: &default
    filesets:
      - "tool_vivado ? (fpga)"
      - "!tool_vivado ? (generic)"
    toplevel: cdc_bus_handshake
