CAPI=2:
name: justint:arbiter:round_robin:1.0.0
description: Round Robin Arbiter

filesets:
  rtl:
    files: [rtl/round_robin_arbiter.sv]
    file_type: systemVerilogSource
    depend:
      - ">=justint:arbiter:fixed:1.0"
      - ">=justint:shared:includes:1.0.0"
targets:
  default: &default
    filesets:
      - rtl
    toplevel: round_robin_arbiter

  formal:
    <<: *default
    flow: sim
    flow_options:
      tool: icarus
      iverilog_options: ["-DFORMAL"]
