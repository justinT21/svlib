CAPI=2:
name: justint:ddr:output:1.0.0
description: ODDR Generic

filesets:
  generic:
    files:
      - rtl/oddr_generic.sv
    file_type: systemVerilogSource

  fpga:
    files:
      - rtl/oddr_fpga.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - "tool_vivado ? (fpga)"
      - "!tool_vivado ? (generic)"
